# Copy to .env and fill in. Every value has a safe (or clearly-marked
# insecure-for-dev-only) default in app/core/config.py, so a bare `.env`
# with nothing but OXYLABS_* is enough to run the app locally against
# `docker compose up postgres redis` - see CLAUDE.md "Local development".

ENV=development
LOG_LEVEL=INFO

# --- database ---
# Local dev (docker-compose's `postgres` service - see docker-compose.yml):
#   DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cargotrack
# Live/hosted Postgres (RDS, Supabase, Neon, Render, Railway, etc.) - same
# psycopg3 DSN shape, just point host/user/password/dbname at the real
# instance. Most hosted providers require SSL - either add `?sslmode=require`
# to the URL, or `?sslmode=verify-full&sslrootcert=<path>` if they hand you a
# CA cert; psycopg reads sslmode straight off the URL's query string, no code
# changes needed either way.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<database>?sslmode=require

# Tune down from the defaults (10 + 10 = 20 connections from the API process
# alone, not counting the arq worker or Alembic) if your hosted plan caps
# total concurrent connections low (common on free/hobby tiers).
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=10

# --- redis / background jobs (arq) ---
REDIS_URL=redis://localhost:6379/0

# --- auth / JWT ---
# Required in production (core/config.py refuses the dev fallback outside
# development/test). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- OAuth apps (Google Cloud Console) ---
# Login is unavailable until both of these are set (see
# services/oauth_providers.py) - the rest of the API works fine without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI registered with the OAuth app, plus
# /v1/auth/oauth/{provider}/callback.
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# Where the browser lands after OAuth login completes (the frontend app).
FRONTEND_BASE_URL=http://localhost:3000

# --- Stripe billing (test mode keys from the Stripe dashboard) ---
# Billing endpoints respond 503 feature_not_configured until these are set
# (services/billing_service.py) - nothing else in the app depends on them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Price IDs for the Starter/Growth plans - create these as real Stripe
# Prices in *this environment's* Stripe account (scripts/init_db.py seeds
# the Plan rows with whatever's set here; leave unset and Starter/Growth
# just seed with no stripe_price_id, same as Free/Enterprise).
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=

# --- webhooks ---
WEBHOOK_SIGNING_SECRET=dev-only-webhook-secret-change-me

# --- CORS ---
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- carrier scraping (Oxylabs residential proxy) - required for live provider calls ---
OXYLABS_PROXY_HOST=
OXYLABS_PROXY_USERNAME=
OXYLABS_PROXY_PASSWORD=
